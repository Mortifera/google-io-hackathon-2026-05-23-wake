# Wake — environment template. Copy to .env (gitignored) and fill in real values.
# Get a Gemini key from https://aistudio.google.com/api-keys

# Gemini API key — set all three aliases to the same key for SDK compatibility.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Project
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Model defaults
GEMINI_MODEL=gemini-3.5-flash
